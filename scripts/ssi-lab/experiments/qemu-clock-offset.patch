 extern int local_cpu_start_index;
 
+/* 源节点在启动 vCPU 之前发布，路由线程不获取 BQL 或运行中 vCPU 的锁。 */
+static bool cluster_clock_ready;
+static uint64_t cluster_tsc_offset;
+static uint32_t cluster_tsc_khz;
+
+static int cluster_tsc_attr(CPUState *cpu, int command, uint64_t *offset)
+{
+    struct kvm_device_attr attr = {
+        .group = KVM_VCPU_TSC_CTRL,
+        .attr = KVM_VCPU_TSC_OFFSET,
+        .addr = (uintptr_t)offset,
+    };
+
+    return kvm_vcpu_ioctl(cpu, command, &attr);
+}
+
+static int cluster_read_clock(struct kvm_clock_data *data)
+{
+    int ret;
+    uint32_t required = KVM_CLOCK_TSC_STABLE | KVM_CLOCK_HOST_TSC |
+                        KVM_CLOCK_REALTIME;
+
+    memset(data, 0, sizeof(*data));
+    ret = kvm_vm_ioctl(kvm_state, KVM_GET_CLOCK, data);
+    if (ret < 0) {
+        return ret;
+    }
+    if ((data->flags & required) != required) {
+        error_report("SSI clock requires reliable host TSC, flags=%u", data->flags);
+        return -ENOTSUP;
+    }
+    return 0;
+}
+
+/* 只支持原生且一致的频率；缩放 TSC 需要另外实现比例换算。 */
+static int cluster_prepare_tsc(uint64_t *offset, uint32_t *khz)
+{
+    CPUState *cpu;
+    int ret = cluster_tsc_attr(first_cpu, KVM_GET_DEVICE_ATTR, offset);
+
+    if (ret < 0) {
+        return ret;
+    }
+    *khz = 0;
+    CPU_FOREACH(cpu) {
+        CPUX86State *env = cpu_env(cpu);
+        int frequency = kvm_vcpu_ioctl(cpu, KVM_GET_TSC_KHZ);
+
+        if (frequency <= 0 || env->user_tsc_khz) {
+            return -ENOTSUP;
+        }
+        if (*khz && *khz != frequency) {
+            return -EINVAL;
+        }
+        *khz = frequency;
+        ret = cluster_tsc_attr(cpu, KVM_HAS_DEVICE_ATTR, offset);
+        if (ret < 0) {
+            return ret;
+        }
+    }
+    return 0;
+}
+
+static int cluster_set_offsets(uint64_t offset)
+{
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        uint64_t observed = 0;
+        int ret = cluster_tsc_attr(cpu, KVM_SET_DEVICE_ATTR, &offset);
+
+        if (ret < 0) {
+            return ret;
+        }
+        ret = cluster_tsc_attr(cpu, KVM_GET_DEVICE_ATTR, &observed);
+        if (ret < 0) {
+            return ret;
+        }
+        if (observed != offset) {
+            return -EIO;
+        }
+    }
+    return 0;
+}
+
+int kvmclock_get_sample(KVMClockSample *sample)
+{
+    struct kvm_clock_data data;
+    int ret;
+
+    if (!qatomic_load_acquire(&cluster_clock_ready)) {
+        return -EAGAIN;
+    }
+    ret = cluster_read_clock(&data);
+    if (ret < 0) {
+        return ret;
+    }
+    sample->clock = data.clock;
+    sample->host_tsc = data.host_tsc;
+    sample->offset = cluster_tsc_offset;
+    sample->flags = data.flags;
+    sample->khz = cluster_tsc_khz;
+    return 0;
+}
+
+static int cluster_fetch_best(KVMClockSample *best, uint64_t *midpoint,
+                              uint64_t *best_rtt, uint32_t khz)
+{
+    int completed = 0;
+
+    *best_rtt = UINT64_MAX;
+    for (int attempt = 0; attempt < 100 && completed < 16; attempt++) {
+        struct kvm_clock_data before, after;
+        KVMClockSample sample = {};
+        int ret = cluster_read_clock(&before);
+
+        if (ret < 0) {
+            return ret;
+        }
+        ret = kvmclock_fetching(&sample);
+        if (ret == -EAGAIN) {
+            g_usleep(10000);
+            continue;
+        }
+        if (ret < 0) {
+            return ret;
+        }
+        ret = cluster_read_clock(&after);
+        if (ret < 0) {
+            return ret;
+        }
+        if (sample.khz != khz || after.host_tsc < before.host_tsc) {
+            return -ERANGE;
+        }
+        uint64_t rtt = after.host_tsc - before.host_tsc;
+        if (rtt < *best_rtt) {
+            *best = sample;
+            *best_rtt = rtt;
+            *midpoint = before.host_tsc + rtt / 2;
+        }
+        completed++;
+    }
+    if (completed != 16) {
+        return -ETIMEDOUT;
+    }
+    uint64_t rtt_ns = muldiv64(*best_rtt, 1000000, khz);
+    fprintf(stderr, "SSI_CLOCK_SAMPLE samples=%d khz=%u rtt_ns=%" PRIu64
+            " uncertainty_ns=%" PRIu64 " source_flags=%u\n",
+            completed, khz, rtt_ns, rtt_ns / 2, best->flags);
+    if (rtt_ns > 5000000) {
+        return -ETIMEDOUT;
+    }
+    return 0;
+}
+
+static int cluster_start_clock(struct kvm_clock_data *data)
+{
+    KVMClockSample source = {};
+    struct kvm_clock_data local;
+    uint64_t offset, midpoint = 0, rtt;
+    uint32_t khz;
+    int ret = cluster_prepare_tsc(&offset, &khz);
+
+    if (ret < 0) {
+        return ret;
+    }
+    ret = cluster_set_offsets(offset);
+    if (ret < 0) {
+        return ret;
+    }
+    /* 刷新 KVM masterclock，使第一次采样就具有原子时钟/TSC 对。 */
+    ret = kvm_vm_ioctl(kvm_state, KVM_SET_CLOCK, data);
+    if (ret < 0) {
+        return ret;
+    }
+    if (local_cpu_start_index == 0) {
+        ret = cluster_read_clock(&local);
+        if (ret < 0) {
+            return ret;
+        }
+        cluster_tsc_offset = offset;
+        cluster_tsc_khz = khz;
+        qatomic_store_release(&cluster_clock_ready, true);
+        fprintf(stderr, "SSI_CLOCK_SOURCE khz=%u flags=%u offset=%" PRIu64 "\n",
+                khz, local.flags, offset);
+        return 0;
+    }
+
+    ret = cluster_fetch_best(&source, &midpoint, &rtt, khz);
+    if (ret < 0) {
+        return ret;
+    }
+    /* 无符号加减保留 KVM 偏移的模 2^64 语义。 */
+    offset = source.host_tsc + source.offset - midpoint;
+    ret = cluster_set_offsets(offset);
+    if (ret < 0) {
+        return ret;
+    }
+    ret = cluster_read_clock(&local);
+    if (ret < 0) {
+        return ret;
+    }
+    if (local.host_tsc < midpoint ||
+        local.host_tsc - midpoint > (uint64_t)khz * 60000) {
+        return -ERANGE;
+    }
+    data->clock = source.clock +
+                  muldiv64(local.host_tsc - midpoint, 1000000, khz);
+    /* 只用目标机自己的 REALTIME 补偿 ioctl 延迟，不假设两宿主墙钟同步。 */
+    data->realtime = local.realtime;
+    data->flags = KVM_CLOCK_REALTIME;
+    ret = kvm_vm_ioctl(kvm_state, KVM_SET_CLOCK, data);
+    if (ret < 0) {
+        return ret;
+    }
+    fprintf(stderr, "SSI_CLOCK_TARGET khz=%u offset=%" PRIu64
+            " clock=%" PRIu64 "\n", khz, offset, (uint64_t)data->clock);
+    return 0;
+}
