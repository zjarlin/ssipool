+/* 入站处理器和已准入调用都可发起反向请求，不依据 socket bank 再次限流。 */
+int kvm_dsm_exchange_begin(struct kvm *kvm)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (!ret && READ_ONCE(kvm->arch.dsm_stopped))
+		ret = -EPIPE;
+	if (!ret)
+		kvm->arch.dsm_active_exchanges++;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return ret;
+}
+
+static void dsm_counter_update(struct kvm *kvm, u32 *counter, bool add)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	if (add)
+		(*counter)++;
+	else if (!WARN_ON_ONCE(!*counter))
+		(*counter)--;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+}
+
+void kvm_dsm_exchange_done(struct kvm *kvm)
+{
+	dsm_counter_update(kvm, &kvm->arch.dsm_active_exchanges, false);
+}
+
+void kvm_dsm_cache_count(struct kvm *kvm, bool add)
+{
+	dsm_counter_update(kvm, &kvm->arch.dsm_cached_responses, add);
+}
+
+void kvm_dsm_request_count(struct kvm *kvm, bool add)
+{
+	dsm_counter_update(kvm, &kvm->arch.dsm_active_requests, add);
+}
+
+static int kvm_dsm_transport_status(struct kvm *kvm, void __user *argp)
+{
+	struct kvm_dsm_transport_status status = { .version = 1 };
+	unsigned long flags;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	status.exchanges = kvm->arch.dsm_active_exchanges;
+	status.cached_responses = kvm->arch.dsm_cached_responses;
+	status.inbound_requests = kvm->arch.dsm_active_requests;
+	status.error = READ_ONCE(kvm->arch.dsm_error);
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return copy_to_user(argp, &status, sizeof(status)) ? -EFAULT : 0;
+}
