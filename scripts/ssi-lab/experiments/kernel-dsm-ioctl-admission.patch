+/* 普通 VM 也计数，避免与同一 VM 上正在执行的 DSM_ENABLE 竞态。 */
+int kvm_dsm_ioctl_enter(struct kvm *kvm, unsigned int ioctl, bool vm_ioctl)
+{
+	unsigned long flags;
+	int ret;
+
+	if (vm_ioctl && (ioctl == KVM_DSM_IOCTL_DRAIN ||
+			 ioctl == KVM_DSM_IOCTL_STATUS))
+		return 0;
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (!ret && kvm->arch.dsm_ioctl_generation)
+		ret = -ESHUTDOWN;
+	if (!ret) {
+		kvm->arch.dsm_active_ioctls++;
+		ret = 1;
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return ret;
+}
+
+void kvm_dsm_ioctl_leave(struct kvm *kvm, int token)
+{
+	unsigned long flags;
+
+	if (!token)
+		return;
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	if (!WARN_ON_ONCE(!kvm->arch.dsm_active_ioctls))
+		kvm->arch.dsm_active_ioctls--;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+}
+
+/* 超时和信号只结束本次等待，不能重新开放入口或取消先前已准入的事务。 */
+static int kvm_dsm_ioctl_drain(struct kvm *kvm, void __user *argp)
+{
+	struct kvm_dsm_ioctl_drain params;
+	unsigned long flags;
+	long waited;
+	int ret;
+
+	if (copy_from_user(&params, argp, sizeof(params)))
+		return -EFAULT;
+	if (params.version != 1 || params.flags || !params.generation ||
+	    !params.timeout_ms || params.timeout_ms > 30000 || params.reserved)
+		return -EINVAL;
+	/* 不等待管理锁，避免尚未封闭入口就陷入无期限等待；忙时可重试。 */
+	if (!mutex_trylock(&kvm->lock))
+		return -EBUSY;
+	if (!kvm->arch.dsm_enabled) {
+		mutex_unlock(&kvm->lock);
+		return -EINVAL;
+	}
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (!ret && kvm->arch.dsm_ioctl_generation &&
+	    kvm->arch.dsm_ioctl_generation != params.generation)
+		ret = -ESTALE;
+	if (!ret)
+		kvm->arch.dsm_ioctl_generation = params.generation;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	mutex_unlock(&kvm->lock);
+	if (ret)
+		return ret;
+
+	waited = wait_event_killable_timeout(kvm->arch.dsm_ioctl_wait,
+		!READ_ONCE(kvm->arch.dsm_active_ioctls) ||
+		READ_ONCE(kvm->arch.dsm_error), msecs_to_jiffies(params.timeout_ms));
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (!ret && waited < 0)
+		ret = waited;
+	if (!ret && kvm->arch.dsm_active_ioctls)
+		ret = -ETIMEDOUT;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return ret;
+}
+
+static int kvm_dsm_ioctl_status(struct kvm *kvm, void __user *argp)
+{
+	struct kvm_dsm_ioctl_status status = { .version = 1 };
+	unsigned long flags;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	status.generation = kvm->arch.dsm_ioctl_generation;
+	status.state = !!status.generation;
+	status.active = kvm->arch.dsm_active_ioctls;
+	status.error = READ_ONCE(kvm->arch.dsm_error);
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return copy_to_user(argp, &status, sizeof(status)) ? -EFAULT : 0;
+}
