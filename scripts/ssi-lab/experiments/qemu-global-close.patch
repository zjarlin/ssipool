--- /dev/null
+++ b/system/ssi-close.inc
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* 独占 PF28 实验的设备清理与内核关闭接线；普通单节点不进入此路径。 */
+#include "system/kvm.h"
+#include "hw/virtio/virtio.h"
+#include "hw/virtio/virtio-net.h"
+#include "hw/virtio/virtio-blk.h"
+#include "system/iothread.h"
+#include "qemu/rcu.h"
+#include <sys/utsname.h>
+
+static QemuMutex ssi_close_mutex;
+static QemuCond ssi_close_cond;
+static QemuThread ssi_close_thread;
+static bool ssi_close_finished;
+static GPtrArray *ssi_close_devices;
+
+static void ssi_close_fail(const char *reason)
+{
+    error_report("SSI close failed: %s", reason);
+    /* 失败线程可能与主线程争用 BQL，不等待进程退出通知造成二次死锁。 */
+    _exit(EXIT_FAILURE);
+}
+
+/* 设备清理、两次路由屏障和内核协议共用进程级的最终期限。 */
+static void *ssi_close_watchdog(void *opaque)
+{
+    int64_t deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 30000;
+
+    qemu_mutex_lock(&ssi_close_mutex);
+    while (!ssi_close_finished) {
+        int64_t left = deadline - qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+        if (left <= 0) {
+            ssi_close_fail("total shutdown deadline expired");
+        }
+        qemu_cond_timedwait(&ssi_close_cond, &ssi_close_mutex, left);
+    }
+    qemu_mutex_unlock(&ssi_close_mutex);
+    return NULL;
+}
+
+/* 先收集再销毁，避免 unrealize 改变对象树时使遍历失效。 */
+static int ssi_close_collect(Object *obj, void *opaque)
+{
+    VirtIODevice *vdev = (VirtIODevice *)object_dynamic_cast(obj, TYPE_VIRTIO_DEVICE);
+    VirtioDeviceClass *klass;
+    const char *type;
+
+    if (object_dynamic_cast(obj, TYPE_IOTHREAD)) {
+        ssi_close_fail("IOThread producers are outside this experiment");
+    }
+    if (!vdev || !DEVICE(vdev)->realized) {
+        return 0;
+    }
+    type = object_get_typename(obj);
+    if (strcmp(type, TYPE_VIRTIO_NET) && strcmp(type, TYPE_VIRTIO_BLK)) {
+        ssi_close_fail("unverified virtio device type");
+    }
+    klass = VIRTIO_DEVICE_GET_CLASS(vdev);
+    if (klass->get_vhost && klass->get_vhost(vdev)) {
+        ssi_close_fail("vhost producer is outside this experiment");
+    }
+    object_ref(obj);
+    g_ptr_array_add(ssi_close_devices, obj);
+    return 0;
+}
+
+static bool ssi_close_begin(void)
+{
+    MachineState *ms = MACHINE(qdev_get_machine());
+    const char *enabled = getenv("SSHPOOL_LAB_GLOBAL_CLOSE");
+    struct utsname system;
+
+    if (ms->local_cpus == ms->smp.cpus) {
+        return false;
+    }
+    if (!enabled || strcmp(enabled, "1") || !kvm_enabled() || ms->shm_path ||
+        ms->smp.cpus != 4 || ms->local_cpus != 2 || ms->qemu_nums != 2 ||
+        uname(&system) || strcmp(system.release, "7.1.0-rc3-sshpool-gvm-pf28")) {
+        ssi_close_fail("requires the explicit two-node PF28 lab profile");
+    }
+    qemu_mutex_init(&ssi_close_mutex);
+    qemu_cond_init(&ssi_close_cond);
+    qemu_thread_create(&ssi_close_thread, "ssi-close-deadline", ssi_close_watchdog,
+                       NULL, QEMU_THREAD_JOINABLE);
+    ssi_close_devices = g_ptr_array_new_with_free_func((GDestroyNotify)object_unref);
+    object_child_foreach_recursive(object_get_root(), ssi_close_collect, NULL);
+    return true;
+}
+
+static void ssi_close_unrealize_devices(void)
+{
+    for (unsigned int i = 0; i < ssi_close_devices->len; i++) {
+        VirtIODevice *vdev = g_ptr_array_index(ssi_close_devices, i);
+
+        /* 先停 dataplane，再调用已修复的 unrealize 取消保留请求并解除 DMA 映射。 */
+        if (virtio_set_status(vdev, 0)) {
+            ssi_close_fail("device refused stopped status");
+        }
+        qdev_unrealize(DEVICE(vdev));
+        fprintf(stderr, "SSI_DEVICE_UNREALIZED type=%s\n", object_get_typename(OBJECT(vdev)));
+    }
+    g_ptr_array_unref(ssi_close_devices);
+    ssi_close_devices = NULL;
+    drain_call_rcu();
+}
+
+static void ssi_close_kernel(uint64_t generation)
+{
+    struct {
+        uint32_t version, active_ops;
+        uint64_t read_refs, write_refs;
+        int32_t error;
+        uint32_t reserved;
+    } pins = { 0 };
+    struct {
+        uint32_t version, flags;
+        uint64_t generation;
+        uint32_t timeout_ms, reserved;
+    } request = { .version = 1, .generation = generation, .timeout_ms = 15000 };
+    int ret;
+
+    ret = kvm_vm_ioctl(kvm_state, 0x8020aef9, &pins);
+    fprintf(stderr, "SSI_CLOSE_PINS ret=%d version=%u active=%u read=%" PRIu64
+            " write=%" PRIu64 " error=%d reserved=%u\n", ret, pins.version,
+            pins.active_ops, pins.read_refs, pins.write_refs, pins.error, pins.reserved);
+    if (ret || pins.version != 1 || pins.active_ops || pins.read_refs || pins.write_refs ||
+        pins.error || pins.reserved || !generation) {
+        ssi_close_fail("device cleanup did not release native DSM pins");
+    }
+    fprintf(stderr, "SSI_KERNEL_CLOSE_BEGIN generation=%" PRIu64 " timeout_ms=%u\n",
+            generation, request.timeout_ms);
+    ret = kvm_vm_ioctl(kvm_state, 0x4018aefb, &request);
+    fprintf(stderr, "SSI_KERNEL_CLOSE_RESULT generation=%" PRIu64 " ret=%d\n", generation, ret);
+    if (ret) {
+        ssi_close_fail("native global close failed");
+    }
+}
+
+static void ssi_close_end(void)
+{
+    qemu_mutex_lock(&ssi_close_mutex);
+    ssi_close_finished = true;
+    qemu_cond_broadcast(&ssi_close_cond);
+    qemu_mutex_unlock(&ssi_close_mutex);
+    qemu_thread_join(&ssi_close_thread);
+    fprintf(stderr, "SSI_DEVICE_CLOSE_COMPLETE\n");
+}
