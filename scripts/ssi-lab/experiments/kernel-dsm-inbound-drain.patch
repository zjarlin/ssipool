+/* 此确认只证明当前入站流已排空；全 VM 关闭仍需停止外部入口并协调反向连接。 */
+#define DSM_DRAIN_VERSION 1
+#define DSM_DRAIN_ACK_MAGIC 0x44534d44
+#define DSM_DRAIN_TIMEOUT (5 * HZ)
+
+struct dsm_drain_ack {
+	__le32 magic;
+	__le32 version;
+	__le16 sender;
+	__le16 target;
+	__le32 reserved;
+	__le64 generation;
+};
+
+static void dsm_request_done(struct dsm_conn *conn)
+{
+	atomic_dec(&conn->active_requests);
+	wake_up_all(&conn->drain_wait);
+}
+
+/* 持有 dispatch_lock 阻止后续帧越过屏障，但不占用页锁或 SRCU。 */
+static int dsm_drain_request(struct dsm_conn *conn,
+			     const struct dsm_request *req, tx_add_t *tx_add)
+{
+	struct kvm *kvm = conn->kvm;
+	struct dsm_drain_ack ack = {
+		.magic = cpu_to_le32(DSM_DRAIN_ACK_MAGIC),
+		.version = cpu_to_le32(DSM_DRAIN_VERSION),
+		.sender = cpu_to_le16(kvm->arch.dsm_id),
+		.target = cpu_to_le16(req->requester),
+		.generation = cpu_to_le64(req->gfn),
+	};
+	long waited;
+	int ret;
+
+	if (req->version != DSM_DRAIN_VERSION || !req->gfn || req->is_smm ||
+	    req->msg_sender != req->requester || tx_add->txid == 0xff)
+		return -EPROTO;
+
+	conn->drain_seen = true;
+	pr_info("DSM_DRAIN_BEGIN node=%d peer=%u generation=%llu active=%d\n",
+		kvm->arch.dsm_id, req->requester, req->gfn,
+		atomic_read(&conn->active_requests));
+	waited = wait_event_killable_timeout(conn->drain_wait,
+		!atomic_read(&conn->active_requests) ||
+		READ_ONCE(kvm->arch.dsm_error) || READ_ONCE(kvm->arch.dsm_stopped),
+		DSM_DRAIN_TIMEOUT);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (ret)
+		return ret;
+	if (waited < 0 || READ_ONCE(kvm->arch.dsm_stopped))
+		return -EINTR;
+	if (!waited)
+		return -ETIMEDOUT;
+
+	/* 不沿用请求携带的页版本和副本集合；确认体只有本连接的关联信息。 */
+	tx_add->inv_copyset = 0;
+	tx_add->version = 0;
+	ret = network_ops.send(conn->sock, (const char *)&ack, sizeof(ack), 0, tx_add);
+	if (ret < 0)
+		return ret;
+	pr_info("DSM_DRAIN_ACK node=%d peer=%u generation=%llu active=%d\n",
+		kvm->arch.dsm_id, req->requester, req->gfn,
+		atomic_read(&conn->active_requests));
+	return 0;
+}
+
+/* 正数交给页面处理器，零表示屏障已确认，负数保留故障语义。 */
+static int dsm_receive_request(struct dsm_conn *conn, struct dsm_request *req,
+			       tx_add_t *tx_add)
+{
+	struct kvm *kvm = conn->kvm;
+	int ret;
+
+	if (mutex_lock_killable(&conn->dispatch_lock))
+		return -EINTR;
+	ret = network_ops.receive(conn->sock, (char *)req, sizeof(*req), 0, tx_add);
+	if (ret < 0)
+		goto out;
+	/* 屏障后不接受页面请求或第二个标记；EOF 也仍由传输层报告故障。 */
+	if (conn->drain_seen || ret != sizeof(*req) ||
+	    req->req_type > DSM_REQ_DRAIN || req->is_smm > 1 ||
+	    req->requester >= kvm->arch.cluster_iplist_len ||
+	    req->msg_sender >= kvm->arch.cluster_iplist_len ||
+	    req->requester == kvm->arch.dsm_id) {
+		ret = -EPROTO;
+		goto out;
+	}
+	if (req->req_type == DSM_REQ_DRAIN) {
+		ret = dsm_drain_request(conn, req, tx_add);
+		goto out;
+	}
+	atomic_inc(&conn->active_requests);
+out:
+	mutex_unlock(&conn->dispatch_lock);
+	return ret;
+}
