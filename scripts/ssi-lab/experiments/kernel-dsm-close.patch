+++ b/arch/x86/kvm/dsm-close.c
@@ -0,0 +1,721 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/kvm_host.h>
+#include <linux/kvm.h>
+#include "dsm-util.h"
+#include "dsm-close.h"
+#include "ktcp.h"
+
+#define DSM_CLOSE_VERSION 1
+#define DSM_CLOSE_MAGIC 0x44534d43
+#define DSM_CLOSE_MAX_MS 30000
+
+struct dsm_close_ack {
+	__le32 magic;
+	__le16 version;
+	__le16 phase;
+	__le16 sender;
+	__le16 target;
+	__le32 reserved;
+	__le64 generation;
+};
+
+enum dsm_close_wait {
+	DSM_WAIT_SEALED,
+	DSM_WAIT_CONTROLS,
+	DSM_WAIT_FROZEN,
+	DSM_WAIT_PREPARED,
+	DSM_WAIT_IDLE,
+	DSM_WAIT_CLOSED,
+	DSM_WAIT_READY,
+	DSM_WAIT_ALL_READY,
+	DSM_WAIT_FINISHED,
+	DSM_WAIT_EOF,
+	DSM_WAIT_ROOT,
+};
+
+static u32 dsm_close_peers(struct kvm *kvm)
+{
+	return (BIT(kvm->arch.cluster_iplist_len) - 1) & ~BIT(kvm->arch.dsm_id);
+}
+
+/* 只有一个绝对期限；所有阶段、网络等待和提前到达的管理连接共用它。 */
+static int dsm_close_error(struct kvm *kvm)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	int ret = READ_ONCE(kvm->arch.dsm_error);
+
+	if (ret) {
+		return ret;
+	}
+	if (READ_ONCE(kvm->arch.dsm_stopped)) {
+		return -EPIPE;
+	}
+	if (READ_ONCE(close->generation) &&
+	    time_after_eq(jiffies, READ_ONCE(close->deadline))) {
+		return -ETIMEDOUT;
+	}
+	return 0;
+}
+
+static void dsm_close_watchdog(struct work_struct *work)
+{
+	struct dsm_close *close = container_of(to_delayed_work(work),
+						struct dsm_close, watchdog);
+	struct kvm *kvm = close->kvm;
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	if (!close->complete || !close->root_done) {
+		ret = dsm_close_error(kvm);
+		if (!ret) {
+			mod_delayed_work(system_wq, &close->watchdog,
+					 close->deadline - jiffies);
+		}
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	if (ret) {
+		kvm_dsm_fail(kvm, ret);
+	}
+}
+
+int dsm_close_alloc(struct kvm *kvm)
+{
+	struct dsm_close *close = kzalloc(sizeof(*close), GFP_KERNEL);
+
+	if (!close) {
+		return -ENOMEM;
+	}
+	close->kvm = kvm;
+	mutex_init(&close->caller);
+	INIT_DELAYED_WORK(&close->watchdog, dsm_close_watchdog);
+	kvm->arch.dsm_close = close;
+	return 0;
+}
+
+void dsm_close_cancel(struct kvm *kvm)
+{
+	if (kvm->arch.dsm_close) {
+		cancel_delayed_work_sync(&kvm->arch.dsm_close->watchdog);
+	}
+}
+
+void dsm_close_free(struct kvm *kvm)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	int i;
+
+	if (!close) {
+		return;
+	}
+	dsm_close_cancel(kvm);
+	for (i = 0; i < DSM_MAX_INSTANCES; i++) {
+		if (close->outgoing[i]) {
+			ktcp_release(close->outgoing[i]);
+		}
+	}
+	kfree(close);
+	kvm->arch.dsm_close = NULL;
+}
+
+void dsm_close_abort(struct kvm *kvm, int error)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	kconnection_t *cb;
+	int i;
+
+	for (i = 0; i < DSM_MAX_INSTANCES; i++) {
+		cb = smp_load_acquire(&close->outgoing[i]);
+		if (cb) {
+			ktcp_abort(cb, error);
+		}
+	}
+}
+
+bool dsm_close_complete(struct kvm *kvm)
+{
+	return READ_ONCE(kvm->arch.dsm_close->complete);
+}
+
+/* 根线程释放全部入站连接后才发布完成；关闭调用不能依赖随后释放 VM 来唤醒它。 */
+void dsm_close_root_done(struct kvm *kvm)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	kvm->arch.dsm_close->root_done = true;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+}
+
+/* 每个阶段的错误检查、状态提交和唤醒保持同一顺序。 */
+static int dsm_close_advance(struct kvm *kvm, bool *phase)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = dsm_close_error(kvm);
+	if (!ret) {
+		*phase = true;
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+	return ret;
+}
+
+/* 根线程独占连接清单；此计数把尚无首帧和只收到半帧的连接也纳入验收。 */
+int dsm_close_accept(struct kvm *kvm)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (!ret && close->prepared) {
+		ret = -ESHUTDOWN;
+	}
+	if (!ret) {
+		close->accepted++;
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return ret;
+}
+
+bool dsm_close_frozen(struct kvm *kvm)
+{
+	return READ_ONCE(kvm->arch.dsm_close->frozen);
+}
+
+/* 根线程读尽等待队列后关监听器；关闭集合不能靠某次计数快照冻结。 */
+int dsm_close_freeze_listener(struct kvm *kvm)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	unsigned long flags;
+	int ret;
+
+	if (!READ_ONCE(close->freeze_requested)) {
+		return 0;
+	}
+	ret = ktcp_shutdown_listener(kvm->arch.dsm_listen_sock);
+	if (ret) {
+		return ret;
+	}
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	close->frozen = true;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	pr_info("DSM_CLOSE_FROZEN node=%d accepted=%u\n", kvm->arch.dsm_id, close->accepted);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+	return 0;
+}
+
+static int dsm_close_arm(struct kvm *kvm, u64 generation, u32 timeout_ms)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	unsigned long flags, deadline = jiffies + msecs_to_jiffies(timeout_ms);
+	int ret;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = dsm_close_error(kvm);
+	if (!ret && close->generation && close->generation != generation) {
+		ret = -ESTALE;
+	}
+	if (!ret && close->complete) {
+		ret = -EALREADY;
+	}
+	if (!ret) {
+		if (!close->generation || time_before(deadline, close->deadline)) {
+			close->deadline = deadline;
+		}
+		close->generation = generation;
+		mod_delayed_work(system_wq, &close->watchdog, close->deadline - jiffies);
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return ret;
+}
+
+static bool dsm_close_reached(struct kvm *kvm, enum dsm_close_wait stage)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	u32 peers = dsm_close_peers(kvm);
+
+	switch (stage) {
+	case DSM_WAIT_SEALED:
+		return READ_ONCE(close->begun) && !READ_ONCE(kvm->arch.dsm_active_ioctls);
+	case DSM_WAIT_CONTROLS:
+		return READ_ONCE(close->controls) == peers;
+	case DSM_WAIT_FROZEN:
+		return READ_ONCE(close->frozen);
+	case DSM_WAIT_PREPARED:
+		return READ_ONCE(close->prepared);
+	case DSM_WAIT_IDLE:
+		return !READ_ONCE(kvm->arch.dsm_active_exchanges) &&
+		       !READ_ONCE(kvm->arch.dsm_cached_responses) &&
+		       !READ_ONCE(kvm->arch.dsm_active_requests);
+	case DSM_WAIT_CLOSED:
+		return READ_ONCE(close->closed) + hweight32(peers) == READ_ONCE(close->accepted);
+	case DSM_WAIT_READY:
+		return READ_ONCE(close->ready);
+	case DSM_WAIT_ALL_READY:
+		return READ_ONCE(close->all_ready);
+	case DSM_WAIT_FINISHED:
+		return READ_ONCE(close->finished) == peers;
+	case DSM_WAIT_EOF:
+		return READ_ONCE(close->eof) == READ_ONCE(close->accepted);
+	case DSM_WAIT_ROOT:
+		return READ_ONCE(close->root_done);
+	}
+	return false;
+}
+
+static int dsm_close_wait(struct kvm *kvm, enum dsm_close_wait stage)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	long left, waited;
+	int ret;
+
+	for (;;) {
+		ret = dsm_close_error(kvm);
+		if (ret) {
+			return ret;
+		}
+		if (dsm_close_reached(kvm, stage)) {
+			return 0;
+		}
+		left = (long)(READ_ONCE(close->deadline) - jiffies);
+		if (left <= 0) {
+			return -ETIMEDOUT;
+		}
+		waited = wait_event_killable_timeout(kvm->arch.dsm_ioctl_wait,
+			dsm_close_reached(kvm, stage) || READ_ONCE(kvm->arch.dsm_error) ||
+			READ_ONCE(kvm->arch.dsm_stopped), left);
+		if (waited < 0) {
+			return READ_ONCE(kvm->arch.dsm_error) ?: waited;
+		}
+	}
+}
+
+/* requester 是当前转发节点；msg_sender 是原始源，不能据后者绑定物理连接。 */
+int dsm_close_classify(struct dsm_conn *conn, const struct dsm_request *req)
+{
+	struct kvm *kvm = conn->kvm;
+	struct dsm_close *close = kvm->arch.dsm_close;
+	bool control = req->req_type >= DSM_REQ_PREPARE;
+	unsigned long flags;
+	int ret = 0;
+
+	if (conn->classified) {
+		return conn->peer == req->requester && conn->control == control ? 0 : -EPROTO;
+	}
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	if (control && (req->req_type != DSM_REQ_PREPARE ||
+			close->controls & BIT(req->requester))) {
+		ret = -EPROTO;
+	}
+	if (!ret) {
+		conn->classified = true;
+		conn->control = control;
+		conn->peer = req->requester;
+		if (control) {
+			close->controls |= BIT(conn->peer);
+		}
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+	return ret;
+}
+
+/* 管理连接不持页锁、SRCU 或数据连接的 dispatch_lock，不阻塞反向请求。 */
+int dsm_close_request(struct dsm_conn *conn, const struct dsm_request *req, tx_add_t *tx)
+{
+	struct kvm *kvm = conn->kvm;
+	struct dsm_close *close = kvm->arch.dsm_close;
+	struct dsm_close_ack ack = {
+		.magic = cpu_to_le32(DSM_CLOSE_MAGIC),
+		.version = cpu_to_le16(DSM_CLOSE_VERSION),
+		.phase = cpu_to_le16(req->req_type),
+		.sender = cpu_to_le16(kvm->arch.dsm_id),
+		.target = cpu_to_le16(req->requester),
+		.generation = cpu_to_le64(req->gfn),
+	};
+	enum dsm_close_wait stage;
+	unsigned long flags;
+	int ret;
+
+	if (!req->gfn || req->version != DSM_CLOSE_VERSION || req->is_smm ||
+	    req->msg_sender != req->requester || tx->txid == 0xff ||
+	    tx->inv_copyset || tx->version) {
+		return -EPROTO;
+	}
+	switch (req->req_type) {
+	case DSM_REQ_PREPARE:
+		if (conn->close_phase) {
+			return -EPROTO;
+		}
+		ret = dsm_close_arm(kvm, req->gfn, DSM_CLOSE_MAX_MS);
+		if (ret) {
+			return ret;
+		}
+		stage = DSM_WAIT_SEALED;
+		break;
+	case DSM_REQ_CLOSE:
+		if (conn->close_phase) {
+			return -EPROTO;
+		}
+		stage = DSM_WAIT_PREPARED;
+		break;
+	case DSM_REQ_READY:
+		if (conn->close_phase != DSM_REQ_PREPARE) {
+			return -EPROTO;
+		}
+		stage = DSM_WAIT_READY;
+		break;
+	case DSM_REQ_FINISH:
+		if (conn->close_phase != DSM_REQ_READY) {
+			return -EPROTO;
+		}
+		stage = DSM_WAIT_ALL_READY;
+		break;
+	default:
+		return -EPROTO;
+	}
+	if (READ_ONCE(close->generation) != req->gfn) {
+		return -ESTALE;
+	}
+	ret = dsm_close_wait(kvm, stage);
+	if (ret) {
+		return ret;
+	}
+	if (req->req_type == DSM_REQ_CLOSE && atomic_read(&conn->active_requests)) {
+		/* 全节点根调用已结束仍可能有响应后的释放尾声，等待本地完整封闭。 */
+		ret = dsm_close_wait(kvm, DSM_WAIT_IDLE);
+		if (ret) {
+			return ret;
+		}
+	}
+	ret = ktcp_send(conn->sock, (const char *)&ack, sizeof(ack), 0, tx);
+	if (ret < 0) {
+		return ret;
+	}
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = dsm_close_error(kvm);
+	if (!ret) {
+		conn->close_phase = req->req_type;
+		if (req->req_type == DSM_REQ_CLOSE) {
+			close->closed++;
+		}
+		if (req->req_type == DSM_REQ_FINISH) {
+			close->finished |= BIT(conn->peer);
+		}
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	pr_info("DSM_CLOSE_ACK node=%d peer=%u phase=%u generation=%llu result=%d\n",
+		kvm->arch.dsm_id, conn->peer, req->req_type, req->gfn, ret);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+	return ret;
+}
+
+/* 仅帧边界 EOF 可以走这里；半帧 EOF 仍由 KTCP 返回 ECONNRESET。 */
+int dsm_close_eof(struct dsm_conn *conn)
+{
+	struct kvm *kvm = conn->kvm;
+	struct dsm_close *close = kvm->arch.dsm_close;
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = dsm_close_error(kvm);
+	if (!ret && (!conn->classified || !close->all_ready ||
+		     !(close->finished & BIT(conn->peer)) ||
+		     conn->close_phase != (conn->control ? DSM_REQ_FINISH : DSM_REQ_CLOSE))) {
+		ret = -ECONNRESET;
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	if (ret) {
+		return ret;
+	}
+	ret = ktcp_shutdown_write(conn->sock);
+	if (ret) {
+		return ret;
+	}
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	conn->eof = true;
+	close->eof++;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+	return KTCP_EOF;
+}
+
+static int dsm_close_exchange(struct kvm *kvm, kconnection_t *cb, int peer, int phase)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	struct dsm_request req = {
+		.requester = kvm->arch.dsm_id,
+		.msg_sender = kvm->arch.dsm_id,
+		.gfn = close->generation,
+		.req_type = phase,
+		.version = DSM_CLOSE_VERSION,
+	};
+	struct dsm_close_ack ack;
+	struct ktcp_transaction transaction;
+	tx_add_t tx = {};
+	int ret;
+
+	ret = dsm_close_error(kvm);
+	if (ret) {
+		return ret;
+	}
+	ret = ktcp_begin_transaction(cb, kvm, &transaction);
+	if (ret) {
+		return ret;
+	}
+	tx.txid = transaction.id;
+	ret = ktcp_send(cb, (const char *)&req, sizeof(req), 0, &tx);
+	if (ret < 0) {
+		goto out;
+	}
+	ret = ktcp_receive(cb, (char *)&ack, sizeof(ack), 0, &tx);
+	if (ret < 0) {
+		goto out;
+	}
+	if (ret != sizeof(ack) || le32_to_cpu(ack.magic) != DSM_CLOSE_MAGIC ||
+	    le16_to_cpu(ack.version) != DSM_CLOSE_VERSION || le16_to_cpu(ack.phase) != phase ||
+	    le16_to_cpu(ack.sender) != peer || le16_to_cpu(ack.target) != kvm->arch.dsm_id ||
+	    ack.reserved || le64_to_cpu(ack.generation) != close->generation ||
+	    tx.inv_copyset || tx.version) {
+		ret = -EPROTO;
+		goto out;
+	}
+	ret = dsm_close_error(kvm);
+out:
+	ktcp_end_transaction(cb, &transaction);
+	pr_info("DSM_CLOSE_RECEIVED node=%d peer=%d phase=%d generation=%llu result=%d\n",
+		kvm->arch.dsm_id, peer, phase, close->generation, ret);
+	return ret;
+}
+
+static int dsm_close_controls(struct kvm *kvm, int phase)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	int peer, ret;
+
+	for (peer = 0; peer < kvm->arch.cluster_iplist_len; peer++) {
+		if (peer == kvm->arch.dsm_id) {
+			continue;
+		}
+		if (phase == DSM_REQ_PREPARE) {
+			ret = kvm_dsm_connect(kvm, peer, &close->outgoing[peer]);
+			if (ret) {
+				return ret;
+			}
+		}
+		ret = dsm_close_exchange(kvm, close->outgoing[peer], peer, phase);
+		if (ret) {
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static int dsm_close_data(struct kvm *kvm)
+{
+	kconnection_t *cb;
+	int i, ret;
+
+	for (i = 0; i < DSM_MAX_INSTANCES * 2; i++) {
+		cb = smp_load_acquire(&kvm->arch.dsm_conn_socks[i]);
+		if (!cb) {
+			continue;
+		}
+		ret = dsm_close_exchange(kvm, cb, i % DSM_MAX_INSTANCES, DSM_REQ_CLOSE);
+		if (ret) {
+			return ret;
+		}
+	}
+	return 0;
+}
+
+/* 先半关闭全部发送方向，再收尽所有 EOF，避免节点逐连接等待构成环。 */
+static int dsm_close_sockets(struct kvm *kvm, bool send_eof)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	kconnection_t *cb;
+	tx_add_t tx;
+	char byte;
+	int i, ret;
+
+	for (i = 0; i < DSM_MAX_INSTANCES * 3; i++) {
+		cb = i < DSM_MAX_INSTANCES * 2 ? kvm->arch.dsm_conn_socks[i] :
+			close->outgoing[i - DSM_MAX_INSTANCES * 2];
+		if (!cb) {
+			continue;
+		}
+		if (send_eof) {
+			ret = ktcp_shutdown_write(cb);
+		} else {
+			memset(&tx, 0, sizeof(tx));
+			tx.txid = 0xff;
+			ret = ktcp_receive(cb, &byte, sizeof(byte), KTCP_ALLOW_EOF, &tx);
+			ret = ret == KTCP_EOF ? 0 : (ret < 0 ? ret : -EPROTO);
+		}
+		if (ret) {
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static int dsm_close_run(struct kvm *kvm)
+{
+	struct dsm_close *close = kvm->arch.dsm_close;
+	int ret;
+
+	ret = dsm_close_wait(kvm, DSM_WAIT_SEALED);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_controls(kvm, DSM_REQ_PREPARE);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_wait(kvm, DSM_WAIT_CONTROLS);
+	if (ret) {
+		return ret;
+	}
+	/* 所有根调用已返回，等待根线程真正停止监听并登记此前接受的每个连接。 */
+	ret = dsm_close_advance(kvm, &close->freeze_requested);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_wait(kvm, DSM_WAIT_FROZEN);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_wait(kvm, DSM_WAIT_IDLE);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_transport_try_fence(kvm, close->generation);
+	if (ret) {
+		return ret;
+	}
+	/* 本地页面准入已真正封闭后，才允许入站连接确认 CLOSE。 */
+	ret = dsm_close_advance(kvm, &close->prepared);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_data(kvm);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_wait(kvm, DSM_WAIT_CLOSED);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_advance(kvm, &close->ready);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_controls(kvm, DSM_REQ_READY);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_advance(kvm, &close->all_ready);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_controls(kvm, DSM_REQ_FINISH);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_wait(kvm, DSM_WAIT_FINISHED);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_sockets(kvm, true);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_sockets(kvm, false);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_wait(kvm, DSM_WAIT_EOF);
+	if (ret) {
+		return ret;
+	}
+	ret = dsm_close_advance(kvm, &close->complete);
+	if (ret) {
+		return ret;
+	}
+	return dsm_close_wait(kvm, DSM_WAIT_ROOT);
