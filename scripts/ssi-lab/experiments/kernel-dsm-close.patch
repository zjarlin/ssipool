+int dsm_close_ioctl(struct kvm *kvm, void __user *argp)
+{
+	struct kvm_dsm_ioctl_drain params;
+	struct dsm_close *close = kvm->arch.dsm_close;
+	unsigned long flags;
+	int ret;
+
+	if (copy_from_user(&params, argp, sizeof(params))) {
+		return -EFAULT;
+	}
+	if (params.version != 1 || params.flags || !params.generation ||
+	    !params.timeout_ms || params.timeout_ms > DSM_CLOSE_MAX_MS || params.reserved ||
+	    !READ_ONCE(kvm->arch.dsm_enabled)) {
+		return -EINVAL;
+	}
+	if (!mutex_trylock(&close->caller)) {
+		return -EBUSY;
+	}
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (!ret && (kvm->arch.dsm_active_pin_ops || kvm->arch.dsm_read_pins ||
+		     kvm->arch.dsm_write_pins)) {
+		ret = -EBUSY;
+	}
+	if (!ret && kvm->arch.dsm_ioctl_generation &&
+	    kvm->arch.dsm_ioctl_generation != params.generation) {
+		ret = -ESTALE;
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	if (ret) {
+		goto out;
+	}
+	ret = dsm_close_arm(kvm, params.generation, params.timeout_ms);
+	if (ret) {
+		goto out;
+	}
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	/* 二次检查与封闭原子执行，固定调用不能在两段临界区之间漏入。 */
+	ret = dsm_close_error(kvm);
+	if (!ret && (kvm->arch.dsm_active_pin_ops || kvm->arch.dsm_read_pins ||
+		     kvm->arch.dsm_write_pins)) {
+		ret = -EBUSY;
+	}
+	if (!ret && kvm->arch.dsm_ioctl_generation &&
+	    kvm->arch.dsm_ioctl_generation != params.generation) {
+		ret = -ESTALE;
+	}
+	if (!ret) {
+		kvm->arch.dsm_ioctl_generation = params.generation;
+		close->begun = true;
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	wake_up_all(&kvm->arch.dsm_ioctl_wait);
+	if (!ret) {
+		ret = dsm_close_run(kvm);
+	}
+	if (ret) {
+		kvm_dsm_fail(kvm, ret);
+		ret = READ_ONCE(kvm->arch.dsm_error);
+	}
+	dsm_close_cancel(kvm);
+	pr_info("DSM_CLOSE_RESULT node=%d generation=%llu accepted=%u closed=%u eof=%u result=%d\n",
+		kvm->arch.dsm_id, close->generation, close->accepted, close->closed, close->eof, ret);
+out:
+	mutex_unlock(&close->caller);
+	return ret;
+}
