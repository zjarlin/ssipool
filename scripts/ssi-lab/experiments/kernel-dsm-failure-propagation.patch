+/* 锁存首个错误；shutdown 唤醒收发，但 socket 仍由原生命周期释放。 */
+int ktcp_abort(struct ktcp_cb *cb, int error)
+{
+	int first;
+
+	if (WARN_ON_ONCE(error >= 0))
+		error = -EIO;
+	first = cmpxchg(&cb->error, 0, error);
+	if (!first) {
+		kernel_sock_shutdown(cb->socket, SHUT_RDWR);
+		first = error;
+	}
+	return first;
+}
 
