+/* 通知标准 KVM 管理接口，并唤醒根线程统一中止全部连接。 */
+void kvm_dsm_fail(struct kvm *kvm, int error)
+{
+	struct task_struct *root;
+
+	if (WARN_ON_ONCE(error >= 0))
+		error = -EIO;
+	if (cmpxchg(&kvm->arch.dsm_error, 0, error))
+		return;
+	pr_err("kvm-dsm: node-%d failed with %d; VM cannot continue\n",
+	       kvm->arch.dsm_id, error);
+	kvm_vm_dead(kvm);
+	root = READ_ONCE(kvm->arch.dsm_thread);
+	if (root && root != current)
+		send_sig(SIGKILL, root, 1);
+}
