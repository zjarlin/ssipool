+	case DSM_PIN_COMMIT:
+		if (!*pending) {
+			ret = -EINVAL;
+			break;
+		}
+		(*pending)--;
+		break;
+	case DSM_PIN_ABORT:
+		if (!*pending || !*total) {
+			ret = -EINVAL;
+			break;
+		}
+		(*pending)--;
+		atomic_dec_return_release(refs);
+		(*total)--;
+		break;
+	case DSM_PIN_RELEASE:
+		if (count == *pending || !*total) {
+			ret = -EINVAL;
+			break;
+		}
+		atomic_dec_return_release(refs);
+		(*total)--;
