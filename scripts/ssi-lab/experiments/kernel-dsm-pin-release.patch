+/* 整段解除只使用引用锁；不能等待取页线程持有的槽锁或页面锁。 */
+static int kvm_dsm_unpin_range(struct kvm *kvm, hfn_t first, hfn_t end, bool write)
+{
+	struct kvm_dsm_memory_slot *slot;
+	struct kvm_dsm_info *info;
+	hfn_t vfn;
+	int count, ret = 0;
+	u32 pending;
+
+	mutex_lock(&kvm->arch.dsm_pin_refs_lock);
+	for (vfn = first; vfn < end; vfn++) {
+		slot = vfn_to_hvaslot(kvm, vfn);
+		if (!slot) {
+			continue;
+		}
+		info = &slot->vfn_dsm_state[vfn - slot->base_vfn];
+		count = atomic_read(write ? &info->pinned_write : &info->pinned_read);
+		pending = write ? info->pending_write : info->pending_read;
+		if (count <= 0 || pending >= count) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	for (vfn = first; vfn < end; vfn++) {
+		slot = vfn_to_hvaslot(kvm, vfn);
+		if (!slot) {
+			continue;
+		}
+		ret = kvm_dsm_pin_transition(kvm, slot, vfn, write, DSM_PIN_RELEASE);
+		if (WARN_ON_ONCE(ret)) {
+			break;
+		}
+	}
+out:
+	mutex_unlock(&kvm->arch.dsm_pin_refs_lock);
 	return ret;
 }
 
