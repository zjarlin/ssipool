+/* 超时或信号不封闭传输，已准入请求仍可完成反向调用和响应消费。 */
+static int kvm_dsm_transport_fence(struct kvm *kvm, void __user *argp)
+{
+	struct kvm_dsm_ioctl_drain params;
+	unsigned long deadline;
+	long remaining;
+	int ret;
+
+	if (copy_from_user(&params, argp, sizeof(params)))
+		return -EFAULT;
+	if (params.version != 1 || params.flags || !params.generation ||
+	    !params.timeout_ms || params.timeout_ms > 30000 || params.reserved)
+		return -EINVAL;
+	if (!READ_ONCE(kvm->arch.dsm_enabled))
+		return -EINVAL;
+	deadline = jiffies + msecs_to_jiffies(params.timeout_ms);
+	for (;;) {
+		ret = dsm_transport_try_fence(kvm, params.generation);
+		if (ret != -EAGAIN)
