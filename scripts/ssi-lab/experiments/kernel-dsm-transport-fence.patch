+/* 无锁条件只用来唤醒；成功判断和状态提交必须在下面的准入锁内重做。 */
+static bool dsm_transport_idle(struct kvm *kvm)
+{
+	return !READ_ONCE(kvm->arch.dsm_active_ioctls) &&
+	       !READ_ONCE(kvm->arch.dsm_active_pin_ops) &&
+	       !READ_ONCE(kvm->arch.dsm_read_pins) &&
+	       !READ_ONCE(kvm->arch.dsm_write_pins) &&
+	       !READ_ONCE(kvm->arch.dsm_active_exchanges) &&
+	       !READ_ONCE(kvm->arch.dsm_cached_responses) &&
+	       !READ_ONCE(kvm->arch.dsm_active_requests);
+}
