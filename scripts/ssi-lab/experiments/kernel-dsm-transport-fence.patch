+/* 返回 EAGAIN 表示仍有真实工作；该路径不改变任何准入状态。 */
+static int dsm_transport_try_fence(struct kvm *kvm, u64 generation)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	ret = READ_ONCE(kvm->arch.dsm_error);
+	if (!ret && READ_ONCE(kvm->arch.dsm_stopped))
+		ret = -EPIPE;
+	if (!ret && !kvm->arch.dsm_ioctl_generation)
+		ret = -EPERM;
+	if (!ret && kvm->arch.dsm_ioctl_generation != generation)
+		ret = -ESTALE;
+	if (!ret && !dsm_transport_idle(kvm))
+		ret = -EAGAIN;
+	if (!ret)
+		kvm->arch.dsm_transport_generation = generation;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return ret;
+}
