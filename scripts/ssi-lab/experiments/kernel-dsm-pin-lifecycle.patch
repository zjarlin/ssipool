+/* 全 VM 计数与页面引用在同一锁下改变，失败不能产生负数或假零。 */
+static noinline int kvm_dsm_pin_change(struct kvm *kvm,
+		struct kvm_dsm_memory_slot *slot, hfn_t vfn, bool write, bool unpin)
+{
+	atomic_t *refs = write ? &slot->vfn_dsm_state[vfn - slot->base_vfn].pinned_write :
+		&slot->vfn_dsm_state[vfn - slot->base_vfn].pinned_read;
+	u64 *total = write ? &kvm->arch.dsm_write_pins : &kvm->arch.dsm_read_pins;
+	unsigned long flags;
+	int count, ret = 0;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	count = atomic_read(refs);
+	if (unpin) {
+		if (count <= 0 || !*total) {
+			ret = -EINVAL;
+		} else {
+			atomic_dec_return_release(refs);
+			(*total)--;
+		}
+	} else if (count < 0 || count == INT_MAX || *total == U64_MAX) {
+		ret = -EOVERFLOW;
+	} else {
+		atomic_inc(refs);
+		(*total)++;
+	}
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return ret;
+}
+
+/* 调用者持有 slots_lock，固定期间不得删除、移动或重建任何内存槽。 */
+bool kvm_dsm_has_pins(struct kvm *kvm)
+{
+	unsigned long flags;
+	bool busy;
+
+	lockdep_assert_held(&kvm->slots_lock);
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	busy = kvm->arch.dsm_read_pins || kvm->arch.dsm_write_pins;
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return busy;
+}
+
+static int kvm_dsm_pin_status(struct kvm *kvm, void __user *argp)
+{
+	struct kvm_dsm_pin_status status = { .version = 1 };
+	unsigned long flags;
+
+	spin_lock_irqsave(&kvm->arch.dsm_admission_lock, flags);
+	status.active_ops = kvm->arch.dsm_active_pin_ops;
+	status.read_refs = kvm->arch.dsm_read_pins;
+	status.write_refs = kvm->arch.dsm_write_pins;
+	status.error = READ_ONCE(kvm->arch.dsm_error);
+	spin_unlock_irqrestore(&kvm->arch.dsm_admission_lock, flags);
+	return copy_to_user(argp, &status, sizeof(status)) ? -EFAULT : 0;
+}
