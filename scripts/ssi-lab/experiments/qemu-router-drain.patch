+/* 在 vCPU 停止且块层排空之后执行；路由处理器在此期间仍负责完成先前请求。 */
+void drain_io_router(void)
+{
+    MachineState *ms = MACHINE(qdev_get_machine());
+    QemuThread watchdog;
+    CPUState *cpu;
+    unsigned int index = router_index();
+    uint64_t expected;
+    unsigned int stopped = 0;
+
+    if (ms->local_cpus == ms->smp.cpus) {
+        return;
+    }
+    CPU_FOREACH(cpu) {
+        if (!cpu->stopped) {
+            error_report("SSI drain reached before vCPU %d stopped", cpu->cpu_index);
+            exit(EXIT_FAILURE);
+        }
+        stopped++;
+    }
+    expected = (UINT64_MAX >> (64 - ms->qemu_nums)) & ~(UINT64_C(1) << index);
+    /* 序号只关联同一 TCP 会话内的确认，不提供协议认证或跨连接重放保护。 */
+    drain_nonce = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) | UINT64_C(1);
+    qemu_thread_create(&watchdog, "ssi-drain-deadline", router_drain_watchdog,
+                       NULL, QEMU_THREAD_JOINABLE);
+    qemu_mutex_lock(&io_forwarding_mutex);
+    qemu_mutex_lock(&drain_mutex);
+    qatomic_set(&drain_started, true);
+    fprintf(stderr, "SSI_DRAIN_LOCAL node=%u stopped=%u nonce=%" PRIu64 "\n",
+            index, stopped, drain_nonce);
+    qemu_cond_broadcast(&drain_cond);
+    qemu_mutex_unlock(&drain_mutex);
+    /* 先向所有对端发送标记，再读取确认，避免不同遍历顺序导致互等。 */
+    for (unsigned int peer = 0; peer < ms->qemu_nums; peer++) {
+        if (peer == index) {
+            continue;
+        }
+        if (!req_files[peer] || !rsp_files[peer]) {
+            error_report("SSI missing drain connection");
+            exit(EXIT_FAILURE);
+        }
+        qemu_put_be16(req_files[peer], DRAIN);
+        qemu_put_sbe32(req_files[peer], CPU_INDEX_ANY);
+        qemu_put_be32(req_files[peer], ROUTER_PROTOCOL_VERSION);
+        qemu_put_be32(req_files[peer], index);
+        qemu_put_be32(req_files[peer], peer);
+        qemu_put_be64(req_files[peer], drain_nonce);
+        qemu_fflush(req_files[peer]);
+        if (qemu_file_get_error(req_files[peer])) {
+            error_report("SSI drain marker send failed");
+            exit(EXIT_FAILURE);
+        }
+    }
+    for (unsigned int peer = 0; peer < ms->qemu_nums; peer++) {
+        if (peer == index) {
+            continue;
+        }
+        uint32_t magic = qemu_get_be32(rsp_files[peer]);
+        uint32_t version = qemu_get_be32(rsp_files[peer]);
+        uint32_t sender = qemu_get_be32(rsp_files[peer]);
+        uint32_t target = qemu_get_be32(rsp_files[peer]);
+        uint64_t nonce = qemu_get_be64(rsp_files[peer]);
+        if (qemu_file_get_error(rsp_files[peer]) || magic != ROUTER_DRAIN_ACK ||
+            version != ROUTER_PROTOCOL_VERSION || sender != peer ||
+            target != index || nonce != drain_nonce) {
+            error_report("SSI missing or invalid drain acknowledgement");
+            exit(EXIT_FAILURE);
+        }
+        fprintf(stderr, "SSI_DRAIN_ACK_RECEIVED node=%u peer=%u nonce=%" PRIu64 "\n",
+                index, peer, nonce);
+    }
+    qemu_mutex_unlock(&io_forwarding_mutex);
+    qemu_mutex_lock(&drain_mutex);
+    while (drain_received != expected) {
+        qemu_cond_wait(&drain_cond, &drain_mutex);
+    }
+    drain_finished = true;
+    qemu_cond_broadcast(&drain_cond);
+    qemu_mutex_unlock(&drain_mutex);
+    qemu_thread_join(&watchdog);
+    fprintf(stderr, "SSI_DRAIN_COMPLETE node=%u peers=%u\n", index, ms->qemu_nums - 1);
+}
