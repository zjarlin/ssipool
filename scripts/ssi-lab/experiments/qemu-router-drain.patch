+/* 主线程和各入站处理器共同维护单次关闭屏障，不用 EOF 代替确认。 */
+static QemuMutex drain_mutex;
+static QemuCond drain_cond;
+static bool drain_started;
+static bool drain_finished;
+static uint64_t drain_seen;
+static uint64_t drain_received;
+static uint64_t drain_nonce;
+
+static unsigned int router_index(void)
+{
+    MachineState *ms = MACHINE(qdev_get_machine());
+    return ms->local_cpu_start_index / ms->local_cpus;
+}
+
+static void router_forward_lock(void)
+{
+    qemu_mutex_lock(&io_forwarding_mutex);
+    if (qatomic_read(&drain_started)) {
+        error_report("SSI router generated traffic after local drain");
+        exit(EXIT_FAILURE);
+    }
+}
+
+static void *router_drain_watchdog(void *opaque)
+{
+    int64_t deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + ROUTER_DRAIN_TIMEOUT_MS;
+
+    qemu_mutex_lock(&drain_mutex);
+    while (!drain_finished) {
+        int64_t left = deadline - qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+        if (left <= 0) {
+            error_report("SSI router drain deadline expired");
+            exit(EXIT_FAILURE);
+        }
+        qemu_cond_timedwait(&drain_cond, &drain_mutex, left);
+    }
+    qemu_mutex_unlock(&drain_mutex);
+    return NULL;
+}
 
 
