+/* 两种读指令与 MSR/pvclock 共用比例和偏移，保留权限及 AUX 语义。 */
+static int handle_lab_tsc(struct kvm_vcpu *vcpu)
+{
+	bool rdtscp = vmx_get_exit_reason(vcpu).basic == EXIT_REASON_RDTSCP;
+	struct msr_data aux = { .index = MSR_TSC_AUX };
+	u64 tsc;
+
+	if (!vcpu->arch.lab_tsc_scaling || is_guest_mode(vcpu))
+		return kvm_handle_invalid_op(vcpu);
+	if (rdtscp && !guest_cpu_cap_has(vcpu, X86_FEATURE_RDTSCP)) {
+		kvm_queue_exception(vcpu, UD_VECTOR);
+		return 1;
+	}
+	if (vmx_get_cpl(vcpu) && kvm_read_cr4_bits(vcpu, X86_CR4_TSD)) {
+		kvm_inject_gp(vcpu, 0);
+		return 1;
+	}
+	if (rdtscp && vmx_get_msr(vcpu, &aux)) {
+		kvm_inject_gp(vcpu, 0);
+		return 1;
+	}
+	tsc = kvm_read_l1_tsc(vcpu, rdtsc_ordered());
+	kvm_rax_write(vcpu, (u32)tsc);
+	kvm_rdx_write(vcpu, tsc >> 32);
+	if (rdtscp)
+		kvm_rcx_write(vcpu, (u32)aux.data);
+	return kvm_skip_emulated_instruction(vcpu);
+}
