--- a/arch/x86/kvm/ivy.c
+++ b/arch/x86/kvm/ivy.c
@@ -28,6 +28,7 @@
 #include "mmu.h"
 
 #include <linux/kthread.h>
+#include <linux/sched/signal.h>
 #include <linux/mmu_context.h>
 
 static u64 dsm_page_fault_counter;
@@ -557,6 +558,11 @@
 			continue;
 
 retry_handle_req:
+		/* 缺失内存槽或页面状态重试也必须响应根线程发出的取消。 */
+		if (kthread_should_stop() || fatal_signal_pending(current)) {
+			ret = -EINTR;
+			goto out;
+		}
 		idx = srcu_read_lock(&kvm->srcu);
 		memslot = __gfn_to_memslot(__kvm_memslots(kvm, req.is_smm),
