+			schedule_timeout_interruptible(1);
 			goto retry_handle_req;
 		}
 
@@ -580,7 +586,7 @@
 			pr_warn("%s: kvm %d slot of gfn 0x%llx doesn't exist!\n",
 				__func__, kvm->arch.dsm_id, req.gfn);
 			srcu_read_unlock(&kvm->srcu, idx);
-			schedule();
