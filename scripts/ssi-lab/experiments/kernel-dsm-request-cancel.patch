@@ -570,7 +576,7 @@
 			pr_warn("%s: kvm %d invalid gfn 0x%llx!\n", __func__,
 				kvm->arch.dsm_id, req.gfn);
 			srcu_read_unlock(&kvm->srcu, idx);
