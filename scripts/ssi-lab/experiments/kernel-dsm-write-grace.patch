+/* 独占实验开关；关闭时保持原协议，显式拒绝超过一毫秒的配置。 */
+static unsigned int dsm_write_grace_us;
+
+static int dsm_set_write_grace(const char *value, const struct kernel_param *param)
+{
+	unsigned int duration;
+	int ret = kstrtouint(value, 0, &duration);
+
+	if (ret)
+		return ret;
+	if (duration > 1000)
+		return -EINVAL;
+	WRITE_ONCE(*(unsigned int *)param->arg, duration);
+	return 0;
+}
+
+static const struct kernel_param_ops dsm_write_grace_ops = {
+	.set = dsm_set_write_grace,
+	.get = param_get_uint,
+};
+module_param_cb(dsm_write_grace_us, &dsm_write_grace_ops, &dsm_write_grace_us, 0644);
+MODULE_PARM_DESC(dsm_write_grace_us, "实验写授权保留微秒数：0 关闭，最大 1000");
+
+static u64 dsm_write_grant_remaining(struct kvm *kvm,
+				   struct kvm_dsm_memory_slot *slot, hfn_t vfn)
+{
+	u64 now, until;
+
+	if (!READ_ONCE(dsm_write_grace_us) || READ_ONCE(kvm->arch.dsm_stopped) ||
+	    !dsm_is_owner(slot, vfn) || !dsm_is_modified(slot, vfn))
+		return 0;
+	until = slot->vfn_dsm_state[vfn - slot->base_vfn].write_grant_until_ns;
+	now = ktime_get_ns();
+	return until > now ? until - now : 0;
+}
 
