+/* 连接版本必须在任何设备报文与客体执行之前确定，不能借可变长时钟帧协商。 */
+static QemuMutex startup_mutex;
+static QemuCond startup_cond;
+static bool startup_complete;
+static uint64_t startup_received;
+
+static void router_startup_fail(const char *reason)
+{
+    error_report("SSI router startup protocol error: %s", reason);
+    /* 初始化线程可能持有 BQL，失败停止不能等待正常退出通知再次取锁。 */
+    _exit(EXIT_FAILURE);
+}
+
+static void *router_startup_watchdog(void *opaque)
+{
+    int64_t deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + ROUTER_STARTUP_TIMEOUT_MS;
+
+    qemu_mutex_lock(&startup_mutex);
+    while (!startup_complete) {
+        int64_t left = deadline - qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+        if (left <= 0) {
+            router_startup_fail("deadline expired before compatible peers were ready");
+        }
+        qemu_cond_timedwait(&startup_cond, &startup_mutex, left);
+    }
+    qemu_mutex_unlock(&startup_mutex);
+    return NULL;
+}
+
+static void router_write_hello(QEMUFile *file, uint32_t magic, unsigned int target)
+{
+    MachineState *ms = MACHINE(qdev_get_machine());
+
+    qemu_put_be32(file, magic);
+    qemu_put_be32(file, ROUTER_PROTOCOL_VERSION);
+    qemu_put_be32(file, router_index());
+    qemu_put_be32(file, target);
+    qemu_put_be32(file, ms->qemu_nums);
+    qemu_put_be32(file, ms->smp.cpus);
+    qemu_put_be32(file, ms->local_cpus);
+    qemu_fflush(file);
+    if (qemu_file_get_error(file)) {
+        router_startup_fail("hello send failed");
+    }
+}
+
+static unsigned int router_read_hello(QEMUFile *file, uint32_t expected_magic)
+{
+    MachineState *ms = MACHINE(qdev_get_machine());
+    uint32_t magic = qemu_get_be32(file);
+
+    /* 先校验固定前缀，不读取旧版可能永远不会发送的剩余字段。 */
+    if (qemu_file_get_error(file) || magic != expected_magic) {
+        router_startup_fail("missing or invalid hello magic");
+    }
+    uint32_t version = qemu_get_be32(file);
+    if (qemu_file_get_error(file) || version != ROUTER_PROTOCOL_VERSION) {
+        router_startup_fail("incompatible protocol version");
+    }
+    uint32_t sender = qemu_get_be32(file);
+    uint32_t target = qemu_get_be32(file);
+    uint32_t nodes = qemu_get_be32(file);
+    uint32_t cpus = qemu_get_be32(file);
+    uint32_t local_cpus = qemu_get_be32(file);
+    if (qemu_file_get_error(file) || sender >= ms->qemu_nums ||
+        sender == router_index() || target != router_index() ||
+        nodes != ms->qemu_nums || cpus != ms->smp.cpus ||
+        local_cpus != ms->local_cpus) {
+        router_startup_fail("incomplete hello or mismatched node topology");
+    }
+    return sender;
+}
+
+static void router_accept_hello(QEMUFile *request, QEMUFile *response)
+{
+    unsigned int peer = router_read_hello(request, ROUTER_HELLO);
+
+    qemu_mutex_lock(&startup_mutex);
+    if (startup_received & (UINT64_C(1) << peer)) {
+        router_startup_fail("duplicate peer connection");
+    }
+    startup_received |= UINT64_C(1) << peer;
+    qemu_mutex_unlock(&startup_mutex);
+    router_write_hello(response, ROUTER_HELLO_ACK, peer);
+    fprintf(stderr, "SSI_ROUTER_HELLO_RECEIVED node=%u peer=%u version=%u\n",
+            router_index(), peer, ROUTER_PROTOCOL_VERSION);
+    qemu_mutex_lock(&startup_mutex);
+    qemu_cond_broadcast(&startup_cond);
+    /* 单个连接通过不等于本节点全部出入站连接都已通过。 */
+    while (!startup_complete) {
+        qemu_cond_wait(&startup_cond, &startup_mutex);
+    }
+    qemu_mutex_unlock(&startup_mutex);
 }
 
