+/* 接收线程只持时钟状态锁，不获取 BQL、vCPU 或发送方向互斥锁。 */
+int kvmclock_receive_barrier(uint64_t epoch, uint32_t phase,
+                             uint64_t clock_floor, uint64_t tsc_floor)
+{
+    int ret = 0;
+    int64_t deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + CLUSTER_CLOCK_TIMEOUT_MS;
+
+    qemu_mutex_lock(&cluster_clock_mutex);
+    if (!epoch || phase < 1 || phase > 2 || epoch < cluster_clock_epoch ||
+        epoch - cluster_clock_epoch > 1) {
+        ret = -EPROTO;
+        goto out;
+    }
+    while (epoch != cluster_clock_epoch || cluster_clock_phase < phase) {
+        int64_t left = deadline - qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+        if (left <= 0) {
+            ret = -ETIMEDOUT;
+            goto out;
+        }
+        qemu_cond_timedwait(&cluster_clock_cond, &cluster_clock_mutex, left);
+    }
+    if (epoch != cluster_clock_epoch || cluster_clock_phase > 2 ||
+        (cluster_clock_seen & (1U << phase)) ||
+        (phase == 2 && !(cluster_clock_seen & (1U << 1)))) {
+        ret = -EPROTO;
+        goto out;
+    }
+    if (phase == 1) {
+        cluster_clock_floor = MAX(cluster_clock_floor, clock_floor);
+        cluster_tsc_floor = MAX(cluster_tsc_floor, tsc_floor);
+    } else if (clock_floor || tsc_floor) {
+        ret = -EPROTO;
+        goto out;
+    }
+    cluster_clock_seen |= 1U << phase;
+    fprintf(stderr, "SSI_CLOCK_RECEIVE epoch=%" PRIu64 " phase=%u\n", epoch, phase);
+    qemu_cond_broadcast(&cluster_clock_cond);
+out:
+    qemu_mutex_unlock(&cluster_clock_mutex);
+    return ret;
+}
+
+/* 独立于协议锁和 BQL，覆盖锁竞争及静默阻塞的网络读写。 */
+static void *cluster_clock_watchdog(void *opaque)
+{
+    int64_t deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + CLUSTER_CLOCK_TIMEOUT_MS;
+
+    while (!qatomic_load_acquire(&cluster_clock_done)) {
+        if (qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= deadline) {
+            error_report("SSI clock preparation deadline expired");
+            /* exit 回调要获取主线程持有的 BQL，静默失联时必须直接失败终止。 */
+            _exit(EXIT_FAILURE);
+        }
+        g_usleep(10000);
+    }
+    return NULL;
+}
+
+static int cluster_clock_phase_barrier(uint32_t phase,
+                                        uint64_t clock_floor, uint64_t tsc_floor)
+{
+    int ret;
+
+    qemu_mutex_lock(&cluster_clock_mutex);
+    cluster_clock_phase = phase;
+    qemu_cond_broadcast(&cluster_clock_cond);
+    qemu_mutex_unlock(&cluster_clock_mutex);
+    ret = kvmclock_barrier(cluster_clock_epoch, phase, clock_floor, tsc_floor);
+    if (ret) {
+        return ret;
+    }
+    qemu_mutex_lock(&cluster_clock_mutex);
+    while (!(cluster_clock_seen & (1U << phase))) {
+        qemu_cond_wait(&cluster_clock_cond, &cluster_clock_mutex);
+    }
+    qemu_mutex_unlock(&cluster_clock_mutex);
+    fprintf(stderr, "SSI_CLOCK_BARRIER epoch=%" PRIu64 " phase=%u\n",
+            cluster_clock_epoch, phase);
+    return 0;
+}
+
+static void cluster_clock_reset(void *opaque)
+{
+    KVMClockState *s = opaque;
+
+    if (local_cpus == smp_cpus || !s->cluster_started) {
+        return;
+    }
+    s->cluster_reset = true;
+    qemu_mutex_lock(&cluster_clock_mutex);
+    cluster_clock_ready = false;
+    qemu_mutex_unlock(&cluster_clock_mutex);
+    if (runstate_is_running()) {
+        error_report("SSI running reset requires a separate clock protocol");
+        exit(EXIT_FAILURE);
+    }
+}
