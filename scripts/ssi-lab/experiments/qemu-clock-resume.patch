+void kvmclock_pre_resume(bool step_pending)
+{
+    KVMClockState *s = cluster_clock_device;
+    MachineState *ms = MACHINE(qdev_get_machine());
+    struct kvm_clock_data data = {}, floor = {}, prepared;
+    QemuThread watchdog;
+    CPUState *cpu;
+    uint64_t offset;
+    uint32_t khz;
+    int ret;
+
+    if (ms->local_cpus == ms->smp.cpus) {
