+    qemu_put_be32(request, index);
+    qemu_put_be32(request, peer);
+    qemu_put_be64(request, epoch);
+    qemu_put_be32(request, phase);
+    qemu_put_be64(request, clock_floor);
+    qemu_put_be64(request, tsc_floor);
+    qemu_fflush(request);
+    uint32_t version = qemu_get_be32(response);
+    uint32_t sender = qemu_get_be32(response);
+    uint32_t target = qemu_get_be32(response);
+    uint64_t observed_epoch = qemu_get_be64(response);
+    uint32_t observed_phase = qemu_get_be32(response);
+    if (qemu_file_get_error(request) || qemu_file_get_error(response)) {
+        ret = -EIO;
+    } else if (version != ROUTER_PROTOCOL_VERSION || sender != peer ||
+               target != index || observed_epoch != epoch || observed_phase != phase) {
+        ret = -EPROTO;
+    }
