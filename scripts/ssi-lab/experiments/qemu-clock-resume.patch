+    }
+    if (!s || ms->qemu_nums != 2 || step_pending || s->cluster_reset ||
+        (s->cluster_started ? !runstate_check(RUN_STATE_PAUSED) :
+                              !runstate_check(RUN_STATE_PRELAUNCH))) {
+        error_report("SSI clock supports paired cold start or user-pause resume only");
+        exit(EXIT_FAILURE);
+    }
+    CPU_FOREACH(cpu) {
+        if (!cpu->stopped) {
+            error_report("SSI clock preparation reached before vCPU stopped");
+            exit(EXIT_FAILURE);
+        }
+    }
+    /* 冷启动的监听接收仍依赖主循环，沿用源端先发布的既有路径。 */
+    if (!s->cluster_started) {
+        qemu_mutex_lock(&cluster_clock_mutex);
+        cluster_clock_epoch = 1;
+        qemu_mutex_unlock(&cluster_clock_mutex);
+        return;
+    }
+    qatomic_store_release(&cluster_clock_done, false);
+    qemu_thread_create(&watchdog, "ssi-clock-deadline", cluster_clock_watchdog,
+                       NULL, QEMU_THREAD_JOINABLE);
+    ret = cluster_prepare_tsc(&offset, &khz);
+    if (ret) {
+        goto failed;
+    }
+    if (s->cluster_started) {
+        /* 正常寄存器写回不含 TSC；拒绝客体改写造成的本实例偏移分歧。 */
+        CPU_FOREACH(cpu) {
+            uint64_t observed;
+            ret = cluster_tsc_attr(cpu, KVM_GET_DEVICE_ATTR, &observed);
+            if (ret || observed != offset) {
+                ret = ret ? ret : -ERANGE;
+                goto failed;
+            }
+        }
+        ret = cluster_read_clock(&floor);
+        if (ret) {
+            goto failed;
+        }
+    }
+    qemu_mutex_lock(&cluster_clock_mutex);
+    if (cluster_clock_epoch == UINT64_MAX) {
+        qemu_mutex_unlock(&cluster_clock_mutex);
+        ret = -EOVERFLOW;
+        goto failed;
+    }
+    cluster_clock_epoch++;
+    cluster_clock_phase = 0;
+    cluster_clock_seen = 0;
+    cluster_clock_ready = false;
+    cluster_clock_floor = floor.clock;
+    cluster_tsc_floor = s->cluster_started ? floor.host_tsc + offset : 0;
+    qemu_mutex_unlock(&cluster_clock_mutex);
+    fprintf(stderr, "SSI_CLOCK_PREPARE epoch=%" PRIu64 " state=%s\n",
+            cluster_clock_epoch, RunState_str(runstate_get()));
+    ret = cluster_clock_phase_barrier(1, floor.clock,
+                                      s->cluster_started ? floor.host_tsc + offset : 0);
+    if (ret) {
+        goto failed;
+    }
+    data.clock = s->clock;
+    ret = cluster_start_clock(&data);
+    if (ret) {
+        goto failed;
+    }
+    ret = cluster_tsc_attr(first_cpu, KVM_GET_DEVICE_ATTR, &offset);
+    if (!ret) {
+        ret = cluster_read_clock(&prepared);
+    }
+    if (!ret && (prepared.clock < cluster_clock_floor ||
+                 prepared.host_tsc + offset < cluster_tsc_floor)) {
+        ret = -ERANGE;
+    }
+    if (ret) {
+        goto failed;
+    }
+    fprintf(stderr, "SSI_CLOCK_PREPARED epoch=%" PRIu64 " clock=%" PRIu64
+            " tsc=%" PRIu64 " clock_floor=%" PRIu64 " tsc_floor=%" PRIu64 "\n",
+            cluster_clock_epoch, (uint64_t)prepared.clock,
+            (uint64_t)prepared.host_tsc + offset, cluster_clock_floor, cluster_tsc_floor);
+    ret = cluster_clock_phase_barrier(2, 0, 0);
+    if (ret) {
+        goto failed;
+    }
+    qemu_mutex_lock(&cluster_clock_mutex);
+    cluster_clock_phase = 3;
+    qemu_mutex_unlock(&cluster_clock_mutex);
+    s->cluster_started = true;
+    qatomic_store_release(&cluster_clock_done, true);
+    qemu_thread_join(&watchdog);
+    fprintf(stderr, "SSI_CLOCK_RELEASE epoch=%" PRIu64 "\n", cluster_clock_epoch);
+    return;
+failed:
+    error_report("SSI clock preparation failed: %s", strerror(-ret));
+    exit(EXIT_FAILURE);
 }
 
